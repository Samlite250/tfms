# ---- SMS (Africa's Talking) ----
# Get credentials at https://account.africastalking.com -> Settings -> API Key
# Username: your production username (NOT 'sandbox' for real delivery)
AFRICASTALKING_USERNAME=your-username
AFRICASTALKING_API_KEY=your-api-key-here
# Optional approved sender ID (e.g. MAHEMBE). Leave empty to use shared short code.
AFRICASTALKING_SENDER_ID=
ADMIN_PHONE_NUMBERS=0790268691,0728927353
VITE_ADMIN_PHONE_NUMBERS=0790268691,0728927353


